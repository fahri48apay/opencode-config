{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/qwen3.6-plus:free",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "sk_omniroute"
      },
      "models": {
        "auto/best-coding": { "name": "Auto Best Coding" },
        "auto/best-reasoning": { "name": "Auto Best Reasoning" },
        "auto/best-fast": { "name": "Auto Best Fast" },
        "auto/best-vision": { "name": "Auto Best Vision" }
      }
    }
  },
  "mcp": {
    "penpot": {
      "type": "remote",
      "url": "https://design.penpot.app/mcp/stream?userToken={env:PENPOT_TOKEN}",
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=nlwcqiwnazaoqatnuyqd&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      "enabled": true
    }
  }
}
